{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "kart-maua",
  "version": "0.1.1",
  "identifier": "com.kim.kart-maua",
  "build": {
    "frontendDist": "https://raphads.github.io/kim-front/index.html"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Kart Mauá",
        "url": "https://raphads.github.io/kim-front/index.html",
        "width": 1200,
        "height": 800,
        "center": true,
        "maximized": true,
        "zoomHotkeysEnabled": false,
        "minWidth": 1024,
        "minHeight": 700,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
